# Clerk auth — https://dashboard.clerk.com (API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional public URL of this app (used at Docker build for NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:2233

# --- Reacher (self-hosted email validation) ---
# Local Next (npm run dev) + Reacher in Docker: http://127.0.0.1:8080
# App container talking to Reacher service: docker-compose overrides to http://reacher:8080
REACHER_URL=http://127.0.0.1:8080
# App sends REACHER_SECRET as header x-reacher-secret.
# Reacher validates it against RCH__HEADER_SECRET.
# MUST be identical or you get: Invalid request header "x-reacher-secret"
# Leave both empty to disable auth on Reacher.
REACHER_SECRET=change-me
RCH__HEADER_SECRET=change-me

# Reacher identity (EHLO / MAIL FROM). Prefer a hostname that matches reverse DNS.
RCH__HELLO_NAME=localhost
RCH__FROM_EMAIL=hello@localhost
RCH__SMTP_TIMEOUT=45
RCH__THROTTLE__MAX_REQUESTS_PER_MINUTE=60
RCH__THROTTLE__MAX_REQUESTS_PER_DAY=10000

# Optional default SOCKS5 proxy (port 25 often blocked on VPS/ISP)
# RCH__PROXY__HOST=my.default.proxy.com
# RCH__PROXY__PORT=1081
# RCH__PROXY__USERNAME=user0
# RCH__PROXY__PASSWORD=pass0

# Optional named proxies + MX routing (Reacher >= v0.11.0)
# https://docs.reacher.email/self-hosting/proxies/multiple-proxies
# RCH__OVERRIDES__PROXIES__PROXY1__HOST=11.22.33.44
# RCH__OVERRIDES__PROXIES__PROXY1__PORT=1081
# RCH__OVERRIDES__PROXIES__PROXY1__USERNAME=user1
# RCH__OVERRIDES__PROXIES__PROXY1__PASSWORD=pass1
# RCH__OVERRIDES__PROXIES__PROXY2__HOST=55.66.77.88
# RCH__OVERRIDES__PROXIES__PROXY2__PORT=1081
# RCH__OVERRIDES__PROXIES__PROXY2__USERNAME=user2
# RCH__OVERRIDES__PROXIES__PROXY2__PASSWORD=pass2
# RCH__OVERRIDES__GMAIL__TYPE=smtp
# RCH__OVERRIDES__GMAIL__PROXY=proxy1
# RCH__OVERRIDES__HOTMAILB2B__TYPE=smtp
# RCH__OVERRIDES__HOTMAILB2B__PROXY=proxy2

# Legacy SaaS validators (optional; routes now use Reacher)
MAILSO_API_KEY=
LISTCLEAN_API_KEY=

# Supabase — Project Settings > API (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_YOSE_NGN_RATE=100
