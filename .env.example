# Clerk auth — https://dashboard.clerk.com (API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional public URL of this app (used at Docker build for NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:2233

# --- Reacher (external email validation) ---
# Hosted at reacher-mails.dscrdbots.cc (compose defaults here too).
REACHER_URL=https://reacher-mails.dscrdbots.cc
# App sends REACHER_SECRET as header x-reacher-secret.
# Must match the secret configured on that Reacher instance.
REACHER_SECRET=change-me

# Optional client knobs (compose sets REACHER_USE_BULK=true):
# REACHER_USE_BULK=false
# REACHER_VERIFY_CONCURRENCY=12
# REACHER_REQUEST_TIMEOUT_MS=35000
# REACHER_BULK_MAX_ATTEMPTS=2
# REACHER_MAX_ATTEMPTS=3

# Legacy SaaS validators (optional; routes now use Reacher)
MAILSO_API_KEY=
LISTCLEAN_API_KEY=

# Supabase — Project Settings > API (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_YOSE_NGN_RATE=100
